# Database
DATABASE_URL="postgresql://user:password@localhost:5432/gombe_ruwasa"

# Session
SESSION_SECRET="replace-with-a-random-256-bit-hex-string"

# Image store: "local" or "s3"
IMAGE_STORE="local"

# SMTP (for password reset and lockout notifications)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="no-reply@example.com"
SMTP_PASS="your-smtp-password"

# Internal cron route protection
CRON_SECRET="replace-with-a-random-secret"

# S3-compatible storage (only required when IMAGE_STORE=s3)
S3_ENDPOINT="https://s3.amazonaws.com"
S3_BUCKET="gombe-ruwasa-uploads"
S3_REGION="us-east-1"
S3_ACCESS_KEY="your-access-key"
S3_SECRET_KEY="your-secret-key"
